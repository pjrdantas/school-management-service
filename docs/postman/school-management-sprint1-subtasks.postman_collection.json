        {
          "name": "KAN-37 - Rejeitar turma duplicada no mesmo período",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"TURMA-DUP\",\n  \"nome\": \"Turma Duplicada\",\n  \"capacidade\": 20,\n  \"periodoLetivoId\": {{periodoLetivoId}}\n}"
            },
            "url": "{{baseUrl}}/api/turmas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (!pm.environment.get('duplicadaCriada')) {",
                  "  pm.environment.set('duplicadaCriada', 'true');",
                  "  pm.test('Primeira criação: status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "  });",
                  "} else {",
                  "  pm.test('Segunda criação: status 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
