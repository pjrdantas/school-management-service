          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Body authenticated', function () {",
                  "  pm.expect(pm.response.text()).to.eql('authenticated');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
