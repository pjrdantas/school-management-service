    {
      "name": "01 - Aluno",
      "item": [
        {
          "name": "KAN-14 - Cadastrar aluno válido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Maria dos Santos\",\n  \"cpf\": \"12312312399\",\n  \"email\": \"maria.santos@example.com\",\n  \"dataNascimento\": \"2011-03-10\"\n}"
            },
            "url": "{{baseUrl}}/api/alunos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Retorna payload de aluno', function () {",
                  "  pm.expect(json.id).to.be.a('number');",
                  "  pm.expect(json.nomeCompleto).to.eql('Maria dos Santos');",
                  "  pm.expect(json.cpf).to.eql('12312312399');",
                  "  pm.expect(json.createdAt).to.be.a('string');",
                  "});",
                  "pm.environment.set('alunoId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "KAN-14 - Rejeitar cadastro com CPF inválido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Fulano\",\n  \"cpf\": \"123\",\n  \"email\": \"fulano@example.com\",\n  \"dataNascimento\": \"2012-01-01\"\n}"
            },
            "url": "{{baseUrl}}/api/alunos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Erro padronizado de validação', function () {",
                  "  pm.expect(json.message).to.eql('Dados de entrada inválidos');",
                  "  pm.expect(json.errors).to.be.an('array').that.is.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "KAN-49 - Buscar aluno por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/alunos/{{alunoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Retorna aluno do identificador', function () {",
                  "  pm.expect(json.id).to.eql(Number(pm.environment.get('alunoId')));",
                  "  pm.expect(json.nomeCompleto).to.be.a('string');",
                  "  pm.expect(json.cpf).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "KAN-49 - Retornar 404 ao buscar aluno inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/alunos/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Mensagem de não encontrado', function () {",
                  "  pm.expect(json.message).to.include('Aluno não encontrado');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
