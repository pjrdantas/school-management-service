{
  "info": {
    "_postman_id": "f2f2cf47-d2d8-4bea-9f11-e6fc46e8f6a9",
    "name": "School Management - Sprint 1 Subtasks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execução 1-a-1 dos endpoints da Sprint 1 com cenários de sucesso e erro. Inclui diagnóstico explícito de autenticação para evitar 401 silencioso."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const user = pm.environment.get('auth_user');",
          "const pass = pm.environment.get('auth_password');",
          "if (user && pass) {",
          "  const token = btoa(`${user}:${pass}`);",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Basic ${token}` });",
          "}",
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Diagnóstico de autenticação",
      "item": [
        {
          "name": "Auth OK - GET /api/test/authenticated",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/test/authenticated" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Não pode retornar 401', function () {",
                  "  pm.expect(pm.response.code, 'Credenciais inválidas ou ausentes. Configure auth_user/auth_password no environment.').to.not.eql(401);",
                  "});",
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Body = authenticated', function () { pm.expect(pm.response.text()).to.eql('authenticated'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Aluno (KAN-14, KAN-31, KAN-32, KAN-49)",
      "item": [
        {
          "name": "KAN-14 - Criar aluno válido",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/alunos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Aluno API {{runSuffix}}\",\n  \"cpf\": \"{{cpfValido}}\",\n  \"email\": \"aluno.{{runSuffix}}@example.com\",\n  \"dataNascimento\": \"2010-05-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.environment.set('runSuffix', suffix);",
                  "const baseCpf = suffix.slice(-9);",
                  "pm.environment.set('cpfValido', `123${baseCpf.slice(0,8)}`.slice(0,11));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('alunoId', json.id);",
                  "pm.environment.set('alunoCpf', json.cpf);",
                  "pm.test('Salvou alunoId', () => pm.expect(json.id).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "KAN-49 - Buscar aluno por ID criado",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/alunos/{{alunoId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('ID corresponde ao cadastrado', () => pm.expect(json.id).to.eql(Number(pm.environment.get('alunoId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "KAN-14 - Erro 400 para CPF inválido",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/alunos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Aluno Inválido\",\n  \"cpf\": \"123\",\n  \"email\": \"invalido@example.com\",\n  \"dataNascimento\": \"2010-05-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Catálogo Acadêmico (KAN-18, KAN-35, KAN-36, KAN-37)",
      "item": [
        {
          "name": "KAN-35 - Criar período letivo",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/periodos-letivos",
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"2026.{{runSuffix}}\",\n  \"dataInicio\": \"2026-02-01\",\n  \"dataFim\": \"2026-06-30\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "const json = pm.response.json(); pm.environment.set('periodoLetivoId', json.id);"] } }
          ]
        },
        {
          "name": "KAN-18/KAN-35 - Buscar período criado",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/periodos-letivos/{{periodoLetivoId}}" },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "KAN-36 - Criar turma",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/turmas",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"TURMA-{{runSuffix}}\",\n  \"nome\": \"Turma {{runSuffix}}\",\n  \"capacidade\": 30,\n  \"periodoLetivoId\": {{periodoLetivoId}}\n}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "const json = pm.response.json(); pm.environment.set('turmaId', json.id); pm.environment.set('turmaCodigo', json.codigo);"] } }
          ]
        },
        {
          "name": "KAN-18/KAN-36 - Buscar turma criada",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/turmas/{{turmaId}}" },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "KAN-37 - Criar turma base para teste de duplicidade",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/turmas",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"DUP-{{runSuffix}}\",\n  \"nome\": \"Turma Duplicada Base\",\n  \"capacidade\": 20,\n  \"periodoLetivoId\": {{periodoLetivoId}}\n}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"] } }
          ]
        },
        {
          "name": "KAN-37 - Repetir criação e esperar 409",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/turmas",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"DUP-{{runSuffix}}\",\n  \"nome\": \"Turma Duplicada Base\",\n  \"capacidade\": 20,\n  \"periodoLetivoId\": {{periodoLetivoId}}\n}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"] } }
          ]
        }
      ]
    },
    {
      "name": "03 - Matrícula (KAN-20, KAN-40, KAN-41, KAN-42, KAN-22, KAN-44, KAN-45, KAN-46)",
      "item": [
        {
          "name": "KAN-20/KAN-40/KAN-41 - Criar matrícula válida",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/matriculas",
            "body": { "mode": "raw", "raw": "{\n  \"alunoId\": {{alunoId}},\n  \"turmaId\": {{turmaId}},\n  \"periodoLetivoId\": {{periodoLetivoId}}\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('matriculaId', json.id);",
                  "pm.test('Status inicial ATIVA', () => pm.expect(json.status).to.eql('ATIVA'));"
                ]
              }
            }
          ]
        },
        {
          "name": "KAN-42 - Erro 404 para aluno inexistente",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/matriculas",
            "body": { "mode": "raw", "raw": "{\n  \"alunoId\": 999999,\n  \"turmaId\": {{turmaId}},\n  \"periodoLetivoId\": {{periodoLetivoId}}\n}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }
          ]
        },
        {
          "name": "KAN-42 - Erro 400 turma/período inconsistente",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/matriculas",
            "body": { "mode": "raw", "raw": "{\n  \"alunoId\": {{alunoId}},\n  \"turmaId\": {{turmaId}},\n  \"periodoLetivoId\": 999999\n}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 400 ou 404 (depende da ordem de validação do backend)', () => pm.expect([400,404]).to.include(pm.response.code));"] } }
          ]
        },
        {
          "name": "KAN-44 - Filtrar matrícula por aluno",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/matriculas?alunoId={{alunoId}}" },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "KAN-45 - Filtrar matrícula por turma",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/matriculas?turmaId={{turmaId}}" },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "KAN-46 - Filtrar matrícula por período",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/matriculas?periodoLetivoId={{periodoLetivoId}}" },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "KAN-22 - Filtrar matrícula por status ATIVA",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/matriculas?status=ATIVA" },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "KAN-22 - Status inválido deve retornar 400",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/matriculas?status=INVALIDO" },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "auth_user", "value": "admin" },
    { "key": "auth_password", "value": "admin" }
  ]
}
