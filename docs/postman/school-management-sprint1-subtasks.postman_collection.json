      "name": "03 - Matrícula",
      "item": [
        {
          "name": "KAN-20/KAN-40/KAN-41 - Criar matrícula válida (status inicial ATIVA)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alunoId\": {{alunoId}},\n  \"turmaId\": {{turmaId}},\n  \"periodoLetivoId\": {{periodoLetivoId}}\n}"
            },
            "url": "{{baseUrl}}/api/matriculas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set('matriculaId', json.id);",
                  "pm.test('Matrícula criada com status inicial ATIVA', function () {",
                  "  pm.expect(json.id).to.be.a('number');",
                  "  pm.expect(json.alunoId).to.eql(Number(pm.environment.get('alunoId')));",
                  "  pm.expect(json.turmaId).to.eql(Number(pm.environment.get('turmaId')));",
                  "  pm.expect(json.periodoLetivoId).to.eql(Number(pm.environment.get('periodoLetivoId')));",
                  "  pm.expect(json.status).to.eql('ATIVA');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
